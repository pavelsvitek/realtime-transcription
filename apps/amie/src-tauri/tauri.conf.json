{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amie",
  "version": "0.1.0",
  "identifier": "com.pavel.amie",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amie",
        "width": 960,
        "height": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/nemotron-bridge"
    ],
    "resources": [
      "../licenses/NVIDIA-OPEN-MODEL-LICENSE.txt",
      "../licenses/NOTICE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NEI4MTI0MDdGNUI4NTMKUldSVHVQVUhKSUZMeE95TkFDaXFsc1VScUV4NU9MeU5ibnR5YkFzUWlRcmZWTGs0R1JEMlc3QzkK",
      "endpoints": [
        "https://github.com/pavelsvitek/realtime-transcription/releases/latest/download/latest.json"
      ]
    }
  }
}

