{
  "name": "realtime-transcription",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter amie tauri",
    "dev:desktop": "pnpm --filter amie tauri",
    "dev:web": "pnpm --filter web dev",
    "dev:web-prototype": "pnpm --filter web-prototype dev",
    "dev:server": "pnpm --filter server dev",
    "deploy:server": "pnpm --filter server deploy",
    "test:desktop": "pnpm --filter amie test",
    "setup:signing": "pnpm --filter amie setup:signing",
    "fake-zoom": "bash apps/fake-zoom-app/scripts/run.sh",
    "fake-zoom:transcript": "bash apps/fake-zoom-app/scripts/show-transcript.sh"
  }
}
